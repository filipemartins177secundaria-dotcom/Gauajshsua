local function findGreenLuckButton()
    local function scanGui(g)
        local best = nil
        for _, d in ipairs(g:GetDescendants()) do
            if d:IsA("TextButton") or d:IsA("ImageButton") then
                local bg = d.BackgroundColor3
                local isGreen = bg.G > 0.5 and bg.R < 0.5 and bg.B < 0.5
                if isGreen then
                    local txt = ""
                    pcall(function() txt = norm(d.Text) end)
                    for _, child in ipairs(d:GetDescendants()) do
                        if child:IsA("TextLabel") or child:IsA("Text") then
                            pcall(function() txt = txt .. " " .. norm(child.Text) end)
                        end
                    end
                    if txt:find("%$") then return d end
                    if not best then best = d end
                end
            end
        end
        return best
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then local b = scanGui(pg) if b then return b end end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then
        for _, g in ipairs(core:GetChildren()) do
            if g ~= gui then local b = scanGui(g) if b then return b end end
        end
    end
    return nil
end

local function clickButton(btn)
    if not btn then return false end
    pcall(function()
        btn:Activate()
        if btn.MouseButton1Click then
            if executor.firesignal then pcall(executor.firesignal, btn.MouseButton1Click) end
            pcall(function() btn.MouseButton1Click:Fire() end)
        end
        if btn.MouseButton1Down then
            if executor.firesignal then pcall(executor.firesignal, btn.MouseButton1Down) end
            pcall(function() btn.MouseButton1Down:Fire() end)
        end
    end)
    return true
end

local function doAutoBuyLuckV3()
    if not autoBuyLuckV3 then return end
    if os.clock() - lastBuyLuckV3 < 1 then return end
    lastBuyLuckV3 = os.clock()
    local greenBtn = findGreenLuckButton()
    if greenBtn then clickButton(greenBtn) return end
    local function scanDollar(g)
        for _, d in ipairs(g:GetDescendants()) do
            if d:IsA("TextButton") or d:IsA("ImageButton") then
                local txt = ""
                pcall(function() txt = norm(d.Text) end)
                for _, child in ipairs(d:GetDescendants()) do
                    if child:IsA("TextLabel") or child:IsA("Text") then
                        pcall(function() txt = txt .. " " .. norm(child.Text) end)
                    end
                end
                if txt:find("%$") and (txt:find("m") or txt:find("b") or txt:find("k")) then
                    if not (txt:find("maximo") or txt:find("máximo") or txt:find("max")) then
                        if not (txt:find("x100") or txt:find("x10")) then return d end
                    end
                end
            end
        end
        return nil
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then local b = scanDollar(pg) if b then clickButton(b) return end end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then
        for _, g in ipairs(core:GetChildren()) do
            if g ~= gui then local b = scanDollar(g) if b then clickButton(b) return end end
        end
    end
end

