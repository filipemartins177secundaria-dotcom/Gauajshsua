local function ChilliV2RunToEgg(eggModel, fallbackPos, isAborted)
    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not root or humanoid.Health <= 0 then
        return false, "Personagem indisponível"
    end

    local oldAutoRotate = humanoid.AutoRotate
    local runSpeedMultiplier = 2.5
    local climbShare = 0.5
    local baseSpeed = math.max((tonumber(humanoid.WalkSpeed) or 16) * runSpeedMultiplier, 8)
    local runHeight = 50
    local startedAt = os.clock()
    local lastProgressAt = startedAt
    local lastPosition = root.Position
    local arrived = false

    pcall(function()
        humanoid.PlatformStand = false
        humanoid.AutoRotate = false
        if character:FindFirstChildWhichIsA("Tool") then
            humanoid:UnequipTools()
        end
    end)

    while os.clock() - startedAt < 240 do
        if isAborted and isAborted() then break end

        character = LP.Character
        humanoid = character and character:FindFirstChildOfClass("Humanoid")
        root = character and character:FindFirstChild("HumanoidRootPart")
        if not character or not humanoid or not root or humanoid.Health <= 0 then break end

        local targetPos = getLiveEggPos(eggModel, fallbackPos)
        if typeof(targetPos) ~= "Vector3" then break end

        local currentPos = root.Position
        local horizontalDelta = Vector3.new(
            targetPos.X - currentPos.X,
            0,
            targetPos.Z - currentPos.Z
        )
        local horizontalDistance = horizontalDelta.Magnitude
        local targetBaseY = targetPos.Y + 3
        local desiredY = horizontalDistance <= 3
            and targetBaseY
            or (targetBaseY + runHeight)

        if horizontalDistance <= 4 and math.abs(currentPos.Y - targetBaseY) <= 4 then
            arrived = true
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                humanoid:Move(Vector3.zero, false)
            end)
            break
        end

        local direction = horizontalDistance > 0.01
            and horizontalDelta.Unit
            or Vector3.zero

        local verticalVelocity = math.clamp(
            (desiredY - currentPos.Y) / 0.12,
            -baseSpeed * climbShare,
            baseSpeed * climbShare
        )
        local horizontalSpeed = math.sqrt(math.max(
            baseSpeed * baseSpeed - verticalVelocity * verticalVelocity,
            0
        ))
        local horizontalVelocity = direction * math.min(horizontalSpeed, horizontalDistance / 0.05)

        pcall(function()
            root.AssemblyLinearVelocity = Vector3.new(
                horizontalVelocity.X,
                verticalVelocity,
                horizontalVelocity.Z
            )
            root.AssemblyAngularVelocity = Vector3.zero
            if direction.Magnitude > 0.01 then
                humanoid:Move(direction, false)
            else
                humanoid:Move(Vector3.zero, false)
            end
        end)

        if (currentPos - lastPosition).Magnitude >= 1.5 then
            lastPosition = currentPos
            lastProgressAt = os.clock()
        elseif os.clock() - lastProgressAt >= 1.5 then
            pcall(function() humanoid.Jump = true end)
            lastProgressAt = os.clock()
        end

        RunService.Heartbeat:Wait()
    end

    pcall(function()
        if root and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if humanoid and humanoid.Parent then
            humanoid:Move(Vector3.zero, false)
            humanoid.AutoRotate = oldAutoRotate
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)

    if arrived then
        local settleUntil = os.clock() + 0.25
        while os.clock() < settleUntil do
            if isAborted and isAborted() then return false, "Interrompido" end
            RunService.Heartbeat:Wait()
        end
    end

    if isAborted and isAborted() then return false, "Interrompido" end
    if not arrived then return false, "Chilli RunTo não chegou ao ovo" end
    return true
end

