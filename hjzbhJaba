local function ChilliV2TweenToPortal(targetPart, duration, isAborted)
    local root = findHRP()
    if not (root and targetPart and targetPart:IsA("BasePart")) then
        return false, "Portal/personagem indisponível"
    end
    local targetCFrame = CFrame.new(targetPart.Position) * root.CFrame.Rotation
    local ok, tween = pcall(function()
        return TweenService:Create(
            root,
            TweenInfo.new(duration or 2, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
            {CFrame = targetCFrame}
        )
    end)
    if not ok or not tween then return false, "Não foi possível iniciar Tween até ao portal" end
    local done = false
    local conn = tween.Completed:Connect(function() done = true end)
    tween:Play()
    while not done do
        if isAborted and isAborted() then
            pcall(function() tween:Cancel() end)
            conn:Disconnect()
            return false, "Interrompido"
        end
        if not findHRP() then
            pcall(function() tween:Cancel() end)
            conn:Disconnect()
            return false, "Personagem indisponível"
        end
        RunService.Heartbeat:Wait()
    end
    conn:Disconnect()
    root = findHRP()
    if not root then
        return false, "Personagem indisponível após o Tween"
    end

    -- Retry fix: reaproxima e re-toque até 3s antes de falhar
    local retryDeadline = os.clock() + 3
    while os.clock() < retryDeadline do
        if isAborted and isAborted() then return false, "Interrompido" end
        root = findHRP()
        if not root then return false, "Personagem indisponível" end
        local distanceToPortal = (root.Position - targetPart.Position).Magnitude
        if distanceToPortal <= 10 then
            ChilliV2Touch(root, targetPart)
            return true
        end
        pcall(function()
            local nearPosition = targetPart.Position + Vector3.new(0, 2, 0)
            root.CFrame = CFrame.new(nearPosition) * root.CFrame.Rotation
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        ChilliV2Touch(root, targetPart)
        RunService.Heartbeat:Wait()
    end
    root = findHRP()
    local distanceToPortal = root and (root.Position - targetPart.Position).Magnitude or math.huge
    if distanceToPortal <= 18 then return true end
    return false, string.format("Portal ainda a %.1f studs após tentativas", distanceToPortal)
end

