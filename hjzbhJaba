local function natsuFullRefresh()
    NatsuRefreshCache()
    natsuRebuildDrop()
    if NatsuState.SelectedEggUid and not NatsuState.EggsCache[NatsuState.SelectedEggUid] then
        NatsuState.SelectedEggUid = nil
        natsuPetBtn.Text = "Nenhum  v"
    end
end

