            end
        end

        local function clStabilizeAfterGrab(livePos)
            local r = clRoot()
            if not r then return false end
            local safe = typeof(livePos) == "Vector3" and livePos or r.Position
            local safeY = safe.Y + 5
            pcall(function()
                local ground = clGroundY(safe, safe.Y)
                if typeof(ground) == "number" and ground > safe.Y - 30 and ground < safe.Y + 30 then
                    safeY = ground + 4
                end
            end)
            local cf = CFrame.new(safe.X, safeY, safe.Z) * r.CFrame.Rotation
            local untilTime = os.clock() + 0.35
            while os.clock() < untilTime and not aborted() do
                r = clRoot()
                if not r then return false end
                pcall(function()
                    r.CFrame = cf
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
                RunService.Heartbeat:Wait()
            end
            return not aborted() and clRoot() ~= nil
        end

        local function clGrab(uid, timeout)
            local waited, since = 0, 0
            local lastLive = eggPos
            while not hasEggInInventory(uid) and waited < timeout and not aborted() do
                local r = clRoot()
                local live = getLiveEggPos(eggModel, eggPos, uid, true)
                if live then lastLive = live else live = lastLive end
                if r and live then
                    local dist = (r.Position - live).Magnitude
                    if dist > 4 then
                        pcall(function()
                            r.CFrame = CFrame.new(live + Vector3.new(0, 3, 0)) * r.CFrame.Rotation
                            r.AssemblyLinearVelocity = Vector3.zero
                            r.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                    triggerEggPromptsNearTarget(eggModel, live)
                    invokeCarry(uid)
                else
                    invokeCarry(uid)
                end
                local dt = math.max(RunService.Heartbeat:Wait(), 1/240)
                waited += dt
                since += dt
                if since >= 0.06 then since = 0 end
            end
            local r = clRoot()
            if r then pcall(function() r.AssemblyLinearVelocity = Vector3.zero; r.AssemblyAngularVelocity = Vector3.zero end) end
            if hasEggInInventory(uid) then clStabilizeAfterGrab(lastLive) end
            return hasEggInInventory(uid)
        end

        local function clTreadmillQuickPass(uid)
            if hasEggInInventory(uid) or aborted() then return hasEggInInventory(uid) end

            local Remotes, PlotState, stand
            pcall(function()
                Remotes = require(ReplicatedStorage.Shared.Remotes)
                PlotState = require(ReplicatedStorage.Client.PlotState)
            end)
            if not Remotes or not PlotState then return false end

            local deadline = os.clock() + 1.2
            while not stand and os.clock() < deadline and not aborted() do
                pcall(function()
                    local slot = PlotState.GetMySlot()
                    local folder = Workspace:FindFirstChild("__ClientTreadmillRenders")
                    local render = folder and folder:FindFirstChild("TreadmillRender_" .. tostring(slot))
                    local root = render and render:FindFirstChild("Root")
                    if root and root:IsA("BasePart") then stand = root end
                end)
                if not stand then RunService.Heartbeat:Wait() end
            end
            if not stand or aborted() then return false end

            local r = clRoot()
            if not r then return false end

            local mounted = false
            for _ = 1, 3 do
                if aborted() then return false end
                pcall(function()
                    r.CFrame = CFrame.new(stand.Position) * r.CFrame.Rotation
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
                task.wait(0.10)
                local ok, snap = pcall(function()
                    return Remotes.Treadmill.AskRenderSnapshot:InvokeServer()
                end)
                if ok and type(snap) == "table" then
                    for _, activeId in pairs(snap) do
                        if tostring(activeId) == tostring(LocalPlayer.UserId) then
                            mounted = true
                            break
                        end
                    end
                end
                if mounted then break end
            end

            local exitDeadline = os.clock() + 0.9
            repeat
                pcall(function()
                    Remotes.Treadmill.AskDoff:InvokeServer()
                end)
                task.wait(0.10)
                r = clRoot()
            until aborted() or os.clock() >= exitDeadline

            r = clRoot()
            if r and not aborted() then
                pcall(function()
                    r.CFrame = CFrame.new(stand.Position + Vector3.new(0, 4, 7)) * r.CFrame.Rotation
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
                task.wait(0.08)
                pcall(function() Remotes.Treadmill.AskDoff:InvokeServer() end)
            end

            return not aborted() and clRoot() ~= nil
        end

        local function clRegrab(uid)
            if hasEggInInventory(uid) then return true end
            for attempt = 1, 8 do
                if aborted() then return false end
                local live = getLiveEggPos(eggModel, eggPos, uid, true)
                if live then
                    local r = clRoot()
                    if r then
                        pcall(function()
                            r.CFrame = CFrame.new(live + Vector3.new(0, 3, 0)) * r.CFrame.Rotation
                            r.AssemblyLinearVelocity = Vector3.zero
                            r.AssemblyAngularVelocity = Vector3.zero
                        end)
                    end
                    triggerEggPromptsNearTarget(eggModel, live)
                    invokeCarry(uid)
                    local wait = 0
                    while wait < 0.12 and not aborted() do
                        if hasEggInInventory(uid) then
                            clStabilizeAfterGrab(live)
                            return true
                        end
                        wait += RunService.Heartbeat:Wait()
                    end
                else
                    task.wait(0.08)
                end
            end
            return clGrab(uid, 1.5)
        end

        local function clCarrySpeed(distance)
            local ws=clWalkSpeed()
            local base=ws*math.min(CL.CarryRatio,CL.SpeedCap)
            local fast=base*1.5
            local excess=5.5*base
            local limit=fast
            if distance and distance>excess then limit=math.min(fast,base*distance/(distance-excess)) end
            return math.min(math.max(math.min(base*CL.EasyRatio,limit),base),math.max(ws*CL.SpeedCap,base))
        end

        local function clRunHome(lineX,laneZ,releaseCamera)
            local home=clHomePoint()
            local checkpoint=lineX-7
            local height=CL.Height
            local share=math.clamp(CL.ClimbShare,0.1,0.9)
            local descent=height*math.sqrt(1-share*share)/share
            local character=LP.Character
            local humanoid=findHum()
            if humanoid then humanoid.PlatformStand=false end
            local r=clRoot()
            if r and character and height>0.5 and home.Y+height-2>r.Position.Y then
                pcall(function()
                    character:PivotTo(CFrame.new(Vector3.new(r.Position.X,home.Y+height,r.Position.Z))*r.CFrame.Rotation)
                    r.AssemblyLinearVelocity=Vector3.zero; r.AssemblyAngularVelocity=Vector3.zero
                end)
            end
            local startR=clRoot()
            local speed=clCarrySpeed(startR and (Vector3.new(startR.Position.X-home.X,0,startR.Position.Z-home.Z).Magnitude+height*2) or nil)
            local last=os.clock(); local timeout=0
            local lostAttempts=0
            local delivered=false
            while not aborted() and timeout<30 do
                if not hasEggInInventory(uid) then
                    lostAttempts += 1
                    if lostAttempts > 5 then return false end
                    if not clRegrab(uid) then
                        local retryWait=0
                        while retryWait<0.35 and not aborted() and not hasEggInInventory(uid) do
                            retryWait += RunService.Heartbeat:Wait()
                        end
                        if not hasEggInInventory(uid) and not clRegrab(uid) then
                            return false
                        end
                    end
                    r=clRoot()
                    if not r then return false end
                    last=os.clock()
                end
                r=clRoot(); if not r then return false end
                lostAttempts=0
                local now=os.clock(); local dt=math.max(now-last,1/240); last=now; timeout += dt
                local toHome=r.Position.X<=checkpoint+2
                local target=toHome and home or Vector3.new(checkpoint,home.Y,laneZ)
                if toHome and Vector3.new(home.X-r.Position.X,0,home.Z-r.Position.Z).Magnitude<2 then break end
                local aim=clAvoid(r.Position,target)
                local flat=Vector3.new(aim.X-r.Position.X,0,aim.Z-r.Position.Z)
                local remaining=toHome and 0 or math.max(0,r.Position.X-checkpoint)
                local wantY=home.Y+height
                if toHome or remaining<=descent then wantY=home.Y+height*math.clamp(remaining/math.max(descent,1),0,1) end
                local vy=math.clamp((wantY-r.Position.Y)/0.12,-speed*share,speed*share)
                local horizontal=math.sqrt(math.max(speed*speed-vy*vy,0))
                local v=flat.Magnitude>0.01 and flat.Unit*math.min(horizontal,flat.Magnitude/0.05) or Vector3.zero
                pcall(function() r.AssemblyLinearVelocity=Vector3.new(v.X,vy,v.Z) end)
                RunService.Heartbeat:Wait()
            end
            if humanoid then pcall(function() humanoid:Move(Vector3.zero,false) end) end
            if aborted() then return false end
            if not hasEggInInventory(uid) then
                if not clRegrab(uid) then return false end
            end
            local settle=0
            while settle<2 and hasEggInInventory(uid) and not aborted() do settle += RunService.Heartbeat:Wait() end
            if hasEggInInventory(uid) and not aborted() then
                task.wait(0.2)
                invokeDrop()
                local waited=0
                while hasEggInInventory(uid) and waited<1.5 and not aborted() do waited += RunService.Heartbeat:Wait() end
                delivered=not hasEggInInventory(uid)
            end
            return delivered
        end

        local function clInstantTP(uid)
            local started=os.clock()
            local lineX,lineY=clLineInfo()
            local r=clRoot(); if not r then return false end
            local laneZ=math.clamp(r.Position.Z,-425,-300)
            local landing=Vector3.new(lineX+CL.LandOffset,lineY+3.35,laneZ)
            local hopStep=math.max(clWalkSpeed()*CL.HopRatio,CL.HopMin)
            local hopY=r.Position.Y+CL.HopLift
            local x=r.Position.X
            local retries=0
            local releaseCamera=clFrozenCamera()
            clPostClone(); clFpsOn()
            while x-hopStep>landing.X and not aborted() do
                if not hasEggInInventory(uid) then
                    if not clRegrab(uid) then break end
                    local current=clRoot(); if current then x=math.min(x,current.Position.X) end
                    continue
                end
                local nextX=x-hopStep
                local held=0
                while held<CL.HopGap and not aborted() do
                    clPlace(Vector3.new(nextX,hopY,laneZ))
                    held += RunService.Heartbeat:Wait()
                end
                local check=clRoot()
                local pulled=check~=nil and (check.Position.X-nextX>10 or check.AssemblyLinearVelocity.Magnitude>150)
                if pulled and hasEggInInventory(uid) and not aborted() then
                    retries += 1
                    CL.HopGap=math.min(CL.HopGapMax,CL.HopGap+0.02)
                    if retries>CL.HopRetries then break end
                    local settle=0
                    while settle<0.12 and not aborted() do
                        clPlace(Vector3.new(x,hopY,laneZ)); settle += RunService.Heartbeat:Wait()
                    end
                else
                    x=nextX
                    CL.HopGap=math.max(CL.HopGapMin,CL.HopGap-0.01)
                end
            end
            if aborted() then releaseCamera(); clDropClone(); clFpsOff(); return false end
            landing=Vector3.new(landing.X,clGroundY(landing,landing.Y),landing.Z)
            local function land()
                local current=clRoot()
                if current and current.Position.X<=landing.X+1 and current.Position.Y>landing.Y-25 then
                    pcall(function() current.AssemblyLinearVelocity=Vector3.zero end)
                    return
                end
                clPlace(landing)
            end
            land()
            for attempt=1,3 do
                local settle=0
                while settle<CL.LandSettle and not aborted() do settle += RunService.Heartbeat:Wait() end
                local landed=clRoot()
                if hasEggInInventory(uid) and landed and (landed.Position.X-landing.X>12 or landed.Position.Y<landing.Y-25) then land() else break end
            end
            clDropClone()
            if hasEggInInventory(uid) and not aborted() then
                local delay=0
                while delay<CL.DropDelay and not aborted() do delay += RunService.Heartbeat:Wait() end
                invokeDrop()
                local waited=0
                while hasEggInInventory(uid) and waited<1 and not aborted() do waited += RunService.Heartbeat:Wait() end
                local current=clRoot()
                if current then pcall(function() current.AssemblyLinearVelocity=Vector3.zero; current.AssemblyAngularVelocity=Vector3.zero end) end
                releaseCamera(); clDropClone()
                if not clTreadmillQuickPass(uid) then
                    clFpsOff(); return false
                end
                if not clGrab(uid,3) and not clRegrab(uid) then
                    clFpsOff(); return false
                end
                clDropClone()
            end
            releaseCamera()
            local okHome=false
            if hasEggInInventory(uid) then okHome=clRunHome(lineX,laneZ,releaseCamera) end
            clFpsOff()
            return okHome or not hasEggInInventory(uid)
        end

        setNoclip(true)
        local delivered = clInstantTP(uid)
        if aborted() then ctx.msg="Interrompido"; return end
        if not delivered then
            ctx.msg="A volta do Cl Hub não conseguiu concluir"
            return
        end
        ctx.ok=true
        ctx.msg="OK"
    end)

    cleanup()
    if not ok then
        return false, "Erro: " .. tostring(err)
    end
    if state.stopRequested then
        return false, "Parado"
    end
    return ctx.ok, ctx.msg
end

