end

local function ChilliV2TeleportSequence(record, isAborted)
    local zoneName = tostring(record and (record.Zone or record.AreaId) or "")
    if not CHILLI_V2_ZONES[zoneName] then
        return true
    end

    local lanePortal, exitPortal = ChilliV2FindPortals()
    if not (lanePortal and exitPortal) then
        return false, "Portais do Instant Steal V2 não encontrados"
    end
    local character = LP.Character
    local root = findHRP()
    if not (character and root) then return false, "Personagem indisponível" end

    local safePos = Vector3.new(528.7, 70.57, -364.11)
    local paths = {
        { {"GearGiver_Slap", "Podium"}, Vector3.new(-16.415, 21.072, -6.106) },
        { {"World", "Machines", "RiftMachine", "Rift", "Meshes/VoidPortal_Cube.003"}, Vector3.new(-26.776, 1.75, 18.665) },
        { {"__OBJECTS", "Machines", "RiftMachine", "Rift", "Meshes/VoidPortal_Cube.003"}, Vector3.new(-26.776, 1.75, 18.665) },
    }
    for _, entry in ipairs(paths) do
        local obj = Workspace
        for _, childName in ipairs(entry[1]) do
            obj = obj and obj:FindFirstChild(childName) or nil
        end
        if obj and obj:IsA("BasePart") then
            safePos = obj.CFrame:PointToWorldSpace(entry[2])
            break
        end
    end

    if ChilliV2InFuseZone() then
        local deadline = os.clock() + 12
        while ChilliV2InFuseZone() and os.clock() < deadline do
            if isAborted and isAborted() then return false, "Interrompido" end
            root = findHRP()
            if root then
                pcall(function()
                    root.CFrame = CFrame.new(lanePortal.Position) * root.CFrame.Rotation
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
                ChilliV2Touch(root, lanePortal)
            end
            RunService.Heartbeat:Wait()
        end
        if ChilliV2InFuseZone() then return false, "Não conseguiu sair do Fuse Biome" end
    end

    root = findHRP()
    if not root then return false, "Personagem indisponível" end
    local startCFrame = root.CFrame
    local startPos = startCFrame.Position
    local distance = (safePos - startPos).Magnitude
    local tweenDuration = 2
    local targetCFrame = CFrame.new(safePos) * startCFrame.Rotation
    local liftHeight = 7
    local raisedStart = startPos + Vector3.new(0, liftHeight, 0)
    local raisedEnd = safePos + Vector3.new(0, liftHeight, 0)
    local startedAt = os.clock()
    local completed = false
    while not completed do
        if isAborted and isAborted() then return false, "Interrompido" end
        root = findHRP()
        if not root then return false, "Personagem indisponível" end
        local alpha = math.clamp((os.clock() - startedAt) / tweenDuration, 0, 1)
        local pos
        if alpha < 0.12 then
            local upAlpha = alpha / 0.12
            pos = startPos:Lerp(raisedStart, upAlpha)
        elseif alpha < 0.88 then
            local travelAlpha = (alpha - 0.12) / 0.76
            pos = raisedStart:Lerp(raisedEnd, travelAlpha)
        else
            local downAlpha = (alpha - 0.88) / 0.12
            pos = raisedEnd:Lerp(safePos, downAlpha)
        end
        pcall(function()
            root.CFrame = CFrame.new(pos) * startCFrame.Rotation
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        completed = alpha >= 1
        RunService.Heartbeat:Wait()
    end
    root = findHRP()
    if not root or (root.Position - safePos).Magnitude > 3 then
        return false, "Movimento não chegou à safezone do V2"
    end
    pcall(function()
        root.CFrame = targetCFrame
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    local ping = 0.1
    pcall(function() ping = LP:GetNetworkPing() end)
    local settleFor = math.clamp(0.3 + (tonumber(ping) or 0.1), 0.3, 0.5)
    local settleEnd = os.clock() + settleFor
    while os.clock() < settleEnd do
        if isAborted and isAborted() then return false, "Interrompido" end
        root = findHRP()
        if root then
            pcall(function()
                root.CFrame = CFrame.new(safePos) * root.CFrame.Rotation
                root.AssemblyLinearVelocity = Vector3.zero
            end)
        end
        RunService.Heartbeat:Wait()
    end

    local clone = ChilliV2MakeCameraClone(Vector3.new(lanePortal.Position.X + 40, 71, -363))
    local movedToPortal, moveError = ChilliV2TweenToPortal(lanePortal, 2, isAborted)
    if not movedToPortal then
        ChilliV2FreeCamera(clone)
        return false, moveError or "Não conseguiu chegar ao portal da lane"
    end
    local entered = false
    for attempt = 1, 3 do
        if isAborted and isAborted() then
            ChilliV2FreeCamera(clone)
            return false, "Interrompido"
        end
        local attemptEnd = os.clock() + 5
        while os.clock() < attemptEnd do
            if isAborted and isAborted() then
                ChilliV2FreeCamera(clone)
                return false, "Interrompido"
            end
            if ChilliV2InFuseZone() then
                entered = true
                break
            end
            root = findHRP()
            if root then
                if (root.Position - lanePortal.Position).Magnitude > 8 then
                    pcall(function()
                        root.CFrame = CFrame.new(lanePortal.Position + Vector3.new(0, 2, 0)) * root.CFrame.Rotation
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
                ChilliV2Touch(root, lanePortal)
            end
            RunService.Heartbeat:Wait()
        end
        if entered then break end
    end
    if not entered then
        ChilliV2FreeCamera(clone)
        return false, "O portal da lane não ativou (V2)"
    end

    local exitDeadline = os.clock() + 9
    while ChilliV2InFuseZone() and os.clock() < exitDeadline do
        if isAborted and isAborted() then
            ChilliV2FreeCamera(clone)
            return false, "Interrompido"
        end
        root = findHRP()
        if root then
            pcall(function()
                root.CFrame = CFrame.new(exitPortal.Position) * root.CFrame.Rotation
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            ChilliV2Touch(root, exitPortal)
        end
        RunService.Heartbeat:Wait()
    end

    local leaveDeadline = os.clock() + 12
    while ChilliV2InFuseZone() and os.clock() < leaveDeadline do
        if isAborted and isAborted() then
            ChilliV2FreeCamera(clone)
            return false, "Interrompido"
        end
        root = findHRP()
        if root then
            pcall(function()
                root.CFrame = CFrame.new(lanePortal.Position) * root.CFrame.Rotation
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
            ChilliV2Touch(root, lanePortal)
        end
        RunService.Heartbeat:Wait()
    end
    root = findHRP()
    local exited = not ChilliV2InFuseZone() and root ~= nil
        and (root.Position - lanePortal.Position).Magnitude < 200
    ChilliV2FreeCamera(clone)
    if not exited then return false, "Não conseguiu concluir a saída do Fuse Biome" end
    return true
end

