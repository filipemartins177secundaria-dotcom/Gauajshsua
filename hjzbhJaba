--  ANTI-GUARD: HUMANOID SWAP
-- ============================================================
local NatsuAntiGuard = { Original = nil, Clone = nil, Links = {}, Active = false }

local function NatsuAntiGuardDisconnect()
    for _, link in ipairs(NatsuAntiGuard.Links) do
        pcall(function() link:Disconnect() end)
    end
    table.clear(NatsuAntiGuard.Links)
end

local function NatsuAntiGuardSetControls(humanoid)
    pcall(function()
        local playerScripts = LP:FindFirstChild("PlayerScripts")
        local playerModule = playerScripts and playerScripts:FindFirstChild("PlayerModule")
        if playerModule then
            local controls = require(playerModule):GetControls()
            if type(controls) == "table" then
                controls.humanoid = humanoid
            end
        end
    end)
end

local function NatsuAntiGuardRefreshAnimate(character)
    local animate = character and character:FindFirstChild("Animate")
    if animate and animate:IsA("LocalScript") then
        task.spawn(function()
            pcall(function()
                animate.Enabled = false
                RunService.Heartbeat:Wait()
                animate.Enabled = true
            end)
        end)
    end
end

local function NatsuAntiGuardGrounded(humanoid)
    if not humanoid or humanoid.Health <= 0 then return false end
    if humanoid.FloorMaterial ~= Enum.Material.Air then return true end
    local st = humanoid:GetState()
    return st == Enum.HumanoidStateType.Running
        or st == Enum.HumanoidStateType.RunningNoPhysics
        or st == Enum.HumanoidStateType.Landed
end

local function NatsuAntiGuardStop()
    NatsuAntiGuardDisconnect()
    local character = LP.Character
    local original = NatsuAntiGuard.Original
    local clone = NatsuAntiGuard.Clone
    NatsuAntiGuard.Original = nil
    NatsuAntiGuard.Clone = nil
    NatsuAntiGuard.Active = false
    if original and clone then
        pcall(function()
            if character and original.Parent == nil then original.Parent = character end
            local cam = Workspace.CurrentCamera
            if cam and original.Parent == character then cam.CameraSubject = original end
            if original.Parent == character then
                NatsuAntiGuardSetControls(original)
                NatsuAntiGuardRefreshAnimate(character)
            end
            if clone.Parent then clone:Destroy() end
        end)
    elseif clone then
        pcall(function() clone:Destroy() end)
    end
end

local function NatsuAntiGuardStart(skipGroundCheck)
    if NatsuAntiGuard.Active and NatsuAntiGuard.Clone and NatsuAntiGuard.Clone.Parent == LP.Character then
        return true
    end
    if NatsuAntiGuard.Active then NatsuAntiGuardStop() end
    local character = LP.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not character or not humanoid or humanoid.Health <= 0 then return false end
    local deadline = os.clock() + 1.5
    while os.clock() < deadline and not NatsuAntiGuardGrounded(humanoid) do
        RunService.Heartbeat:Wait()
        character = LP.Character
        humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not character or not humanoid or humanoid.Health <= 0 then return false end
    end
    if not NatsuAntiGuardGrounded(humanoid) then return false end
    local oldArchivable = humanoid.Archivable
    local clone
    local ok = pcall(function()
        humanoid.Archivable = true
        clone = humanoid:Clone()
    end)
    pcall(function() humanoid.Archivable = oldArchivable end)
    if not ok or not clone then return false end
    clone.Name = humanoid.Name
    NatsuAntiGuard.Original = humanoid
    NatsuAntiGuard.Clone = clone
    local swapOK = pcall(function()
        humanoid.Parent = nil
        clone.Parent = character
    end)
    if not swapOK or clone.Parent ~= character then
        NatsuAntiGuardStop()
        return false
    end
    local activeHumanoid = character:FindFirstChildOfClass("Humanoid")
    if activeHumanoid ~= clone then
        NatsuAntiGuardStop()
        return false
    end
    NatsuAntiGuard.Active = true
    pcall(function()
        local cam = Workspace.CurrentCamera
        if cam then cam.CameraSubject = clone end
        NatsuAntiGuardSetControls(clone)
        NatsuAntiGuardRefreshAnimate(character)
    end)
    table.insert(NatsuAntiGuard.Links, humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if clone.Parent == character then
            pcall(function() clone.WalkSpeed = humanoid.WalkSpeed end)
        end
    end))
    table.insert(NatsuAntiGuard.Links, humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if clone.Parent == character then
            pcall(function() clone.JumpPower = humanoid.JumpPower end)
        end
    end))
    local animator = humanoid:FindFirstChildOfClass("Animator")
    local cloneAnimator = clone:FindFirstChildOfClass("Animator")
    if animator and cloneAnimator then
        table.insert(NatsuAntiGuard.Links, animator.AnimationPlayed:Connect(function(tr)
            if clone.Parent ~= character or not tr.Animation then return end
            local ok2, cloneTrack = pcall(function() return cloneAnimator:LoadAnimation(tr.Animation) end)
            if not ok2 or not cloneTrack then return end
            pcall(function()
                cloneTrack.Priority = tr.Priority
                cloneTrack.Looped = tr.Looped
                cloneTrack:Play(0.05, math.max(tr.WeightTarget, 0.01), tr.Speed)
            end)
            local stopped
            stopped = tr.Stopped:Connect(function()
                if stopped then stopped:Disconnect() end
                pcall(function() cloneTrack:Stop(0.1) end)
            end)
            table.insert(NatsuAntiGuard.Links, stopped)
        end))
    end
    table.insert(NatsuAntiGuard.Links, clone.Died:Connect(function()
        local original = NatsuAntiGuard.Original
        local currentCharacter = LP.Character
        NatsuAntiGuardDisconnect()
        NatsuAntiGuard.Original = nil
        NatsuAntiGuard.Clone = nil
        NatsuAntiGuard.Active = false
        if original and currentCharacter and original.Parent == nil then
            pcall(function()
                original.Parent = currentCharacter
                local cam = Workspace.CurrentCamera
                if cam then cam.CameraSubject = original end
                NatsuAntiGuardSetControls(original)
                NatsuAntiGuardRefreshAnimate(currentCharacter)
                original.Health = 0
            end)
        end
        pcall(function() clone:Destroy() end)
    end))
    return true
end

local function getEggSlotKey(record, uid)
    if type(record) ~= "table" or not uid then return nil end
    local ok, identity = pcall(function()
        return require(ReplicatedStorage.Shared.Util.AreaEggSlotIdentity)
    end)
    if not ok or type(identity) ~= "table" then return nil end
    local looksLikeFirst = identity.LooksLikeFirstAreaUid or identity.IsFirstAreaUid
    local buildKey = identity.SlotKey or identity.BuildSlotKey
    if type(looksLikeFirst) ~= "function" or type(buildKey) ~= "function" then return nil end
    local okFirst, isFirst = pcall(looksLikeFirst, tostring(uid))
    if not okFirst or not isFirst or record.AreaId == nil or record.NestId == nil then return nil end
    local okKey, key = pcall(buildKey, record.AreaId, record.NestId)
    if okKey then return key end
    return nil
end

local function invokeCarry(uid, record)
    if not AskFieldEggCarry or type(uid) ~= "string" then return false end
    local payload = { Uid = uid }
    local slotKey = getEggSlotKey(record, uid)
    if slotKey ~= nil then payload.FirstAreaSlotKey = slotKey end
    local ok, result = pcall(function()
        if AskFieldEggCarry:IsA("RemoteFunction") then
            return AskFieldEggCarry:InvokeServer(payload)
        end
        AskFieldEggCarry:FireServer(payload)
        return true
    end)
    return ok and result == true
end

local function invokeDrop()
    if not AskFieldEggDrop then return end
    pcall(function()
        if AskFieldEggDrop:IsA"RemoteFunction" then
            AskFieldEggDrop:InvokeServer{ Reason = "PlayerRequest" }
        else
            AskFieldEggDrop:FireServer{ Reason = "PlayerRequest" }
        end
    end)
end

