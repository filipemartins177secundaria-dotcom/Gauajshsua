local function getToolsByTag(tag)
    local list = {}
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") and CollectionService:HasTag(child, tag) then table.insert(list, child) end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") and CollectionService:HasTag(child, tag) then table.insert(list, child) end
        end
    end
    return list
end

local function equipTool(tool)
    local hum = getHum()
    if not hum or not tool then return false end
    local char = LocalPlayer.Character
    if tool.Parent == char then return true end
    pcall(function() hum:EquipTool(tool) end)
    local t = os.clock() + 1
    while tool.Parent ~= char and os.clock() < t do RunService.Heartbeat:Wait() end
    return tool.Parent == char
end

local function unequipTool()
    local hum = getHum()
    if hum then pcall(function() hum:UnequipTools() end) end
end

local lastPlant = 0
local function doAutoPlant()
    if not autoPlant then return end
    if os.clock() - lastPlant < 1 then return end
    lastPlant = os.clock()
    local tools = getToolsByTag("Egg")
    if #tools == 0 then return end
    local bestTool, bestLuck = nil, -1
    for _, t in ipairs(tools) do
        local luck = tonumber(t:GetAttribute("Luck")) or 0
        if luck > bestLuck then bestLuck = luck bestTool = t end
    end
    if not bestTool then return end
    if equipTool(bestTool) then
        local pos = randomPlotPoint()
        if pos then
            fireGame("EggPlaced", { PlantPosition = pos })
            task.wait(0.4)
            unequipTool()
        end
    end
end

-- ===================== AUTO REBIRTH =====================
local function doAutoRebirth()
    if not autoRebirthV3 then return end
    if os.clock() - lastRebirthV3 < 5 then return end
    local rebirths = nil
    pcall(function()
        local m = RS:FindFirstChild("GameData")
        m = m and m:FindFirstChild("Rebirths")
        if m then
            local ok, data = pcall(function() return require(m) end)
            if ok then rebirths = data end
        end
    end)
    if not rebirths or type(rebirths) ~= "table" then return end
    local cur = tonumber(getSaved("Rebirths")) or 0
    local cap = tonumber(rebirths.Cap)
    if cap and cur >= cap then return end
    local cost = nil
    if type(rebirths.GetCost) == "function" then
        local ok, c = pcall(rebirths.GetCost, cur)
        if ok and tonumber(c) then cost = tonumber(c) end
    end
    if cost and getCash() >= cost then
        fireGame("Rebirth")
        lastRebirthV3 = os.clock()
    end
end

-- ===================== AUTO BUY FOOD / RADARS =====================
local shopCooldown = {}
local lastShopAction = 0

local function getShopList(category)
    local list = {}
    pcall(function()
        local shop = RS:FindFirstChild("GameData")
        shop = shop and shop:FindFirstChild("Shop")
        if shop then
            local ok, data = pcall(function() return require(shop) end)
            if ok and type(data) == "table" and type(data[category]) == "table" then
                for name, info in pairs(data[category]) do
                    if type(info) == "table" then
                        table.insert(list, { Name = name, Price = tonumber(info.Price) or 0 })
                    end
                end
            end
        end
    end)
    table.sort(list, function(a,b) return a.Price < b.Price end)
    return list
end

local function countTool(name)
    local n = 0
    for _, cont in ipairs({LocalPlayer:FindFirstChildOfClass("Backpack"), LocalPlayer.Character}) do
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Tool") and string.gsub(child.Name, "%s*%[.*$", "") == name then
                    local a = child:FindFirstChild("Amount", true)
                    n = n + (a and tonumber(a.Value) or 1)
                end
            end
        end
    end
    return n
end

local function doAutoBuy(category)
    if os.clock() - lastShopAction < 3 then return end
    local items = getShopList(category)
    if #items == 0 then return end
    for _, item in ipairs(items) do
        local key = category .. item.Name
        if (shopCooldown[key] or 0) <= os.clock() then
            local price = item.Price
            if getCash() - price >= keepCashV3 then
                fireGame("SetOpenShop", category)
                task.wait(0.15)
                local before = countTool(item.Name)
                fireGame("BuyWithCash", category, item.Name)
                lastShopAction = os.clock()
                task.wait(0.8)
                if countTool(item.Name) <= before then
                    shopCooldown[key] = os.clock() + 30
                end
                return
            end
        end
    end
end

