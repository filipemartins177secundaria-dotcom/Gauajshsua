    Common = 1, Uncommon = 2, Rare = 3, Epic = 4,
    Legendary = 5, Mythic = 6, Cosmic = 7, Secret = 8,
    Eternal = 9, Divine = 10,
}

local NatsuAssets = require(ReplicatedStorage.Data.Assets).Directory
