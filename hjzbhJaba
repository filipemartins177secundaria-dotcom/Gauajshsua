local function natsuRebuildDrop()
    for _, c in ipairs(natsuPetDrop:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("Frame") then c:Destroy() end
    end

    if #NatsuState.EggOrder == 0 then
        local empty = Instance.new("TextButton")
        empty.Size = UDim2.new(1, 0, 0, 30)
        empty.BackgroundColor3 = Color3.fromRGB(30, 27, 42)
        empty.Text = "Nenhum ovo"
        empty.TextColor3 = Color3.fromRGB(150, 150, 165)
        empty.TextSize = 12
        empty.Font = Enum.Font.Gotham
        empty.AutoButtonColor = false
        empty.ZIndex = 21
        empty.Parent = natsuPetDrop
        local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = empty
        return
    end

    for _, uid in ipairs(NatsuState.EggOrder) do
        local entry = NatsuState.EggsCache[uid]
        if entry then
            local info = entry.info
            local item = Instance.new("Frame")
            item.Size = UDim2.new(1, 0, 0, 40)
            item.BackgroundColor3 = Color3.fromRGB(30, 27, 42)
            item.BorderSizePixel = 0
            item.ZIndex = 21
            item.Parent = natsuPetDrop
            local ibc = Instance.new("UICorner"); ibc.CornerRadius = UDim.new(0, 6); ibc.Parent = item

            local bar = Instance.new("Frame")
            bar.Size = UDim2.fromOffset(3, 28)
            bar.Position = UDim2.fromOffset(3, 6)
            bar.BackgroundColor3 = info.color
            bar.BorderSizePixel = 0
            bar.ZIndex = 23
            bar.Parent = item
            local brc = Instance.new("UICorner"); brc.CornerRadius = UDim.new(1, 0); brc.Parent = bar

            local imgFrame = Instance.new("Frame")
            imgFrame.Size = UDim2.fromOffset(30, 30)
            imgFrame.Position = UDim2.fromOffset(10, 5)
            imgFrame.BackgroundColor3 = Color3.fromRGB(18, 15, 26)
            imgFrame.BorderSizePixel = 0
            imgFrame.ZIndex = 23
            imgFrame.Parent = item
            local ifc = Instance.new("UICorner"); ifc.CornerRadius = UDim.new(0, 4); ifc.Parent = imgFrame

            local img = Instance.new("ImageLabel")
            img.Size = UDim2.new(1, -4, 1, -4)
            img.Position = UDim2.fromOffset(2, 2)
            img.BackgroundTransparency = 1
            img.Image = (info.icon ~= "" and info.icon) or ""
            img.ScaleType = Enum.ScaleType.Fit
            img.ZIndex = 24
            img.Parent = imgFrame

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(1, -110, 0, 14)
            nameLbl.Position = UDim2.fromOffset(48, 5)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = info.petName
            nameLbl.TextColor3 = Color3.fromRGB(235, 235, 245)
            nameLbl.TextSize = 12
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
            nameLbl.ZIndex = 23
            nameLbl.Parent = item

            local moneyLbl = Instance.new("TextLabel")
            moneyLbl.Size = UDim2.new(1, -110, 0, 14)
            moneyLbl.Position = UDim2.fromOffset(48, 21)
            moneyLbl.BackgroundTransparency = 1
            moneyLbl.Text = "$" .. formatMoney(info.money) .. "/s"
            moneyLbl.TextColor3 = Color3.fromRGB(80, 230, 140)
            moneyLbl.TextSize = 11
            moneyLbl.Font = Enum.Font.GothamBold
            moneyLbl.TextXAlignment = Enum.TextXAlignment.Left
            moneyLbl.ZIndex = 23
            moneyLbl.Parent = item

            local click = Instance.new("TextButton")
            click.Size = UDim2.new(1, 0, 1, 0)
            click.BackgroundTransparency = 1
            click.Text = ""
            click.ZIndex = 30
            click.Parent = item

            click.MouseButton1Click:Connect(function()
                NatsuState.SelectedEggUid = uid
                natsuPetBtn.Text = info.petName .. "  v"
                natsuPetDrop.Visible = false
                TweenService:Create(natsuPetDrop, TweenInfo.new(0.15), {Size = UDim2.fromOffset(200, 0)}):Play()
            end)
        end
    end
end

