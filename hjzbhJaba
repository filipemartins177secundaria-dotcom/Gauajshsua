local function isHatchableEgg(model)
    if not model or not model.Parent then return false end
    for _, e in ipairs(hatchedEggs) do if e == model then return false end end
    local n = norm(model.Name)
    local isEgg = n:find("egg") or n:find("huevo") or n:find("ovo")
    if not isEgg then return false end
    if n:find("tracker") or n:find("canasta") or n:find("tool") or n:find("guia") or n:find("guide") or n:find("radar") then return false end
    if not isOwned(model) then return false end
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("ProximityPrompt") or d:IsA("ClickDetector") then return true end
        if d:IsA("TextButton") or d:IsA("ImageButton") then return true end
        if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
            local dn = norm(d.Name)
            if dn:find("hatch") or dn:find("chocar") or dn:find("open")
               or dn:find("grow") or dn:find("abrir") or dn:find("eclodir") then return true end
        end
    end
    return false
end

local function findHatchButton(model)
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") then
            local n = norm(d.Name) .. " " .. norm(d.Text)
            if n:find("hatch") or n:find("chocar") or n:find("open")
               or n:find("abrir") or n:find("eclodir") or n:find("grow") then return d end
        end
    end
end

local function hatchEgg(eggModel)
    if not eggModel or not eggModel.Parent then return false end
    if os.clock() - lastHatchTime < 0.4 then return false end
    lastHatchTime = os.clock()
    local part = eggModel:IsA("BasePart") and eggModel or eggModel.PrimaryPart or eggModel:FindFirstChildWhichIsA("BasePart", true)
    if part then tp(CFrame.new(part.Position + Vector3.new(0, 3, 0))) task.wait(0.1) end
    local fired = false
    for _, d in ipairs(eggModel:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            pcall(function() d.HoldDuration = 0 d.MaxActivationDistance = 999 d.RequiresLineOfSight = false d.Enabled = true end)
            for _ = 1, 8 do firePrompt(d) task.wait(0.02) end
            fired = true
        end
    end
    for _, d in ipairs(eggModel:GetDescendants()) do
        if d:IsA("ClickDetector") then
            for _ = 1, 8 do fireClick(d) task.wait(0.02) end
            fired = true
        end
    end
    local btn = findHatchButton(eggModel)
    if btn then
        for _ = 1, 5 do
            pcall(function()
                btn:Activate()
                if btn.MouseButton1Click then
                    if executor.firesignal then pcall(executor.firesignal, btn.MouseButton1Click) end
                    pcall(function() btn.MouseButton1Click:Fire() end)
                end
            end)
            task.wait(0.03)
        end
        fired = true
    end
    for _, d in ipairs(eggModel:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local dn = norm(d.Name)
            if dn:find("hatch") or dn:find("chocar") or dn:find("grow") then
                pcall(function() d:FireServer(eggModel) end)
                pcall(function() d:FireServer() end)
                fired = true
            end
        end
    end
    if fired then table.insert(hatchedEggs, eggModel) return true end
    return false
end

local function cleanHatchList()
    local newList = {}
    for _, e in ipairs(hatchedEggs) do if e and e.Parent then table.insert(newList, e) end end
    hatchedEggs = newList
end

local function scanAndHatch()
    if not autoHatch then return end
    if os.clock() - lastHatchTime < 0.4 then return end
    local _, basePart = findBase()
    local hatchCount = 0
    if basePart then
        local basePos = basePart.Position
        local maxDist = math.max(basePart.Size.X, basePart.Size.Z) * 1.5
        for _, obj in ipairs(workspace:GetDescendants()) do
            if hatchCount >= 2 then break end
            if (obj:IsA("Model") or obj:IsA("BasePart")) and isHatchableEgg(obj) then
                local objPart = obj:IsA("BasePart") and obj or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                if objPart and (objPart.Position - basePos).Magnitude < maxDist then
                    if hatchEgg(obj) then hatchCount = hatchCount + 1 task.wait(0.15) end
                end
            end
        end
    end
    if hatchCount == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if hatchCount >= 1 then break end
            if (obj:IsA("Model") or obj:IsA("BasePart")) and isHatchableEgg(obj) then
                if hatchEgg(obj) then hatchCount = hatchCount + 1 end
            end
        end
    end
end

