        for _, m in ipairs(slots:GetChildren()) do
            if looksLikeEggModel(m) then
                local ok, pivot = pcall(function() return m:GetPivot() end)
                if ok and pivot then
                    add{
                        Uid = m:GetAttribute"UID" or m:GetAttribute"Uid" or m.Name,
                        AssetCategory = m:GetAttribute"Category" or m:GetAttribute"AssetCategory" or m.Name,
                        AreaId = m:GetAttribute"AreaId" or m:GetAttribute"Area",
                        Rarity = m:GetAttribute"Rarity",
                        AssetScale = tonumber(m:GetAttribute"Scale" or m:GetAttribute"AssetScale") or 1,
                        Mutations = m:GetAttribute"Mutations" or m:GetAttribute"Mutation",
                        BoundsCFrame = pivot,
                        CFrame = pivot,
                        State = "Slot",
                        PhysicalModel = m
                    }
                end
            end
        end
    end
    if EggState and EggState.ReadFieldEggs then
        local result, done = nil, false
        task.spawn(function()
            local ok, snap = pcall(EggState.ReadFieldEggs)
            if ok and snap then result = snap end
            done = true
        end)
        local waitUntil = os.clock() + 1.5
        while not done and os.clock() < waitUntil do
            RunService.Heartbeat:Wait()
        end
        if result then
            local recs = result.Records or result
            if type(recs) == "table" then
                for _, r in pairs(recs) do
                    if type(r) == "table" and r.Uid and r.BoundsCFrame and (r.State == "Slot" or r.State == "Dropped" or r.State == nil) then
                        add(r)
                    end
                end
            end
        end
    end
    return out
end
