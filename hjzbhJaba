                            if typeof(cf) == "CFrame" and (rec.State == "Slot" or rec.State == "Dropped" or rec.State == nil) then
                                return cf.Position
                            end
                        end
                    end
                end
            end
        end
        return nil
    end

    local function modelPos()
        if eggModel and eggModel.Parent then
            local ok, pivot = pcall(function() return eggModel:GetPivot() end)
            if ok and pivot then return pivot.Position end
