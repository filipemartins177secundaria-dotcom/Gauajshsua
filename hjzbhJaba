local function triggerEggPromptsNearTarget(model, targetPos, uid)
    local root = findHRP()
    local origin = targetPos or (root and root.Position)
    local prompt, promptPart
    local bestDistance = 14

    local function flatDistance(a, b)
        return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
    end

    local function isOccludedByOtherEgg(part)
        if not origin then return false end
        local chosenName = model and model.Name or nil
        local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
        if slots then
            for _, other in ipairs(slots:GetChildren()) do
                if other:IsA("Model") and other.Name ~= chosenName then
                    local ok, pos = pcall(function() return other:GetPivot().Position end)
                    if ok and pos and flatDistance(pos, origin) + 1.5 < flatDistance(part.Position, origin) then
                        return true
                    end
                end
            end
        end
        for _, other in ipairs(Workspace:GetChildren()) do
            if other:IsA("Model") and other ~= model and #other.Name == 32 and other:FindFirstChild("Hitbox") then
                local ok, pos = pcall(function() return other:GetPivot().Position end)
                if ok and pos and flatDistance(pos, origin) + 1.5 < flatDistance(part.Position, origin) then
                    return true
                end
            end
        end
        return false
    end

    for _, part in ipairs(Workspace:GetChildren()) do
        if part:IsA("BasePart") and part.Name == "SmartPromptPart" then
            local candidate = part:FindFirstChild("CarryAreaEgg")
            if candidate and candidate:IsA("ProximityPrompt") and origin then
                local d = flatDistance(part.Position, origin)
                if d < bestDistance and not isOccludedByOtherEgg(part) then
                    bestDistance, prompt, promptPart = d, candidate, part
                end
            end
        end
    end

    if prompt then
        pcall(function() prompt.HoldDuration = 0 end)
        if typeof(fireproximityprompt) == "function" then
            pcall(fireproximityprompt, prompt)
        end
    end

    if uid and EggState and type(EggState.CarryFieldEgg) == "function" then
        pcall(EggState.CarryFieldEgg, uid)
    end
    return prompt ~= nil
end
local function getLiveEggPos(eggModel, fallback, uid, serverFirst)
    local function serverPos()
        if uid and EggState and EggState.ReadFieldEggs then
            local ok, snap = pcall(EggState.ReadFieldEggs)
