local function firePrompt(prompt)
    if not prompt or not prompt.Parent then return end
    if executor.fireproximityprompt then pcall(executor.fireproximityprompt, prompt) end
    pcall(function()
        if prompt:IsA("ProximityPrompt") then
            prompt:InputHoldBegin(); task.wait(0.01); prompt:InputHoldEnd()
        end
    end)
end

local function fireClick(detector)
    if not detector or not detector.Parent then return end
    if executor.fireclickdetector then pcall(executor.fireclickdetector, detector) end
    pcall(function() if detector:IsA("ClickDetector") then detector.MouseClick:Fire() end end)
end

