        pcall(function() clone:Destroy() end)
        return nil
    end
    for _, item in ipairs(clone:GetDescendants()) do
        if item:IsA("LuaSourceContainer") or item:IsA("ForceField") or item:IsA("Tool") then
            pcall(function() item:Destroy() end)
        elseif item:IsA("BasePart") then
            pcall(function()
                item.Anchored = item == cloneRoot
                item.CanCollide = false
                item.CanQuery = false
                item.CanTouch = false
            end)
        end
    end
    pcall(function()
        cloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        cloneHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        cloneHumanoid.PlatformStand = false
        clone:PivotTo(CFrame.lookAt(atPosition, findHRP() and findHRP().Position or atPosition + Vector3.new(1, 0, 0)))
    end)
    clone.Name = string.format("%08x", math.random(0, 2147483647))
