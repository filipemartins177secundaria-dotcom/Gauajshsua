local function randomPlotPoint()
    local bp = getPlotBase()
    if not bp then return nil end
    local nx = math.max(1, bp.Size.X/2 - 8)
    local nz = math.max(1, bp.Size.Z/2 - 8)
    local ny = bp.Position.Y + bp.Size.Y/2
    local rng = Random.new()
    local v = Vector3.new(rng:NextNumber(-nx, nx), 0, rng:NextNumber(-nz, nz))
    local world = bp.CFrame:PointToWorldSpace(v)
    return Vector3.new(world.X, ny, world.Z)
end

local function isOwned(egg)
    local check = egg
    while check and check ~= workspace do
        local cn = norm(check.Name)
        if cn:find("rancho") or cn:find("ranch") or cn:find("plot") or cn:find("farm") or cn:find("base") then return true end
        for _, plr in ipairs(Players:GetPlayers()) do
            if cn == norm(plr.Name) or cn == norm(plr.DisplayName) then return true end
        end
        local own = check:FindFirstChild("Owner") or (check:FindFirstChild("Data") and check.Data:FindFirstChild("Owner"))
        if own then
            local v = own.Value
            if v == LocalPlayer or tostring(v) == tostring(LocalPlayer.UserId) or tostring(v) == LocalPlayer.Name then return true end
        end
        check = check.Parent
    end
    return false
end

local function scanEggs()
    local results, seen = {}, {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector")) and obj.Parent then
            local egg, parent = nil, obj.Parent
            while parent and parent ~= workspace do
                local n = norm(parent.Name)
                if (parent:IsA("Model") or parent:IsA("BasePart")) and
                   (n:find("huevo") or n:find("egg")) and
                   not (n:find("tracker") or n:find("canasta") or n:find("tool") or n:find("guia") or n:find("radar")) then
                    egg = parent; break
                end
                parent = parent.Parent
            end
            if egg and not seen[egg] and not isOwned(egg) then
                seen[egg] = true
                local info = detectEgg(egg)
                table.insert(results, {
                    model = egg, prompt = obj, name = info.name, luck = info.luck,
                    rarityRank = info.rarityRank, rarityLabel = info.rarityLabel, rarityColor = info.rarityColor,
                })
            end
        end
    end
    table.sort(results, function(a,b)
        if a.rarityRank ~= b.rarityRank then return a.rarityRank > b.rarityRank end
        return (a.luck or 0) > (b.luck or 0)
    end)
    return results, results
end

