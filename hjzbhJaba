natsuGoBtn.MouseButton1Click:Connect(function()
    if NatsuState.Running or state.stealing then
        natsuStatus.Text = "Ja executando"
        natsuStatus.TextColor3 = Color3.fromRGB(255, 190, 80)
        return
    end
    if not NatsuState.SelectedEggUid then
        natsuStatus.Text = "Selecione um ovo primeiro"
        natsuStatus.TextColor3 = Color3.fromRGB(255, 190, 80)
        return
    end
    local entry = NatsuState.EggsCache[NatsuState.SelectedEggUid]
    if not entry or not entry.record then
        NatsuRefreshCache()
        entry = NatsuState.EggsCache[NatsuState.SelectedEggUid]
    end
    if not entry or not entry.record then
        natsuStatus.Text = "Ovo não encontrado"
        natsuStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    NatsuState.Running = true
    local nome = entry.info and entry.info.petName or "Ovo"
    natsuStatus.Text = "Executando: " .. nome
    natsuStatus.TextColor3 = Color3.fromRGB(60, 230, 140)
    task.spawn(function()
        local ok, msg = stealEggV8(entry.record)
        if NatsuState.Running then NatsuState.Running = false end
        if ok then
            natsuStatus.Text = "Concluído"
            natsuStatus.TextColor3 = Color3.fromRGB(60, 230, 140)
        elseif msg == "Interrompido" or msg == "Parado" then
            natsuStatus.Text = "Parado"
            natsuStatus.TextColor3 = Color3.fromRGB(150, 150, 165)
        else
            natsuStatus.Text = tostring(msg or "Falhou")
            natsuStatus.TextColor3 = Color3.fromRGB(255, 100, 100)
        end
    end)
end)

