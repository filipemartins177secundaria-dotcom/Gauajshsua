speedDialStuds = function()
    local inputSpeed = math.clamp(
        math.floor((tonumber(Config.TweenSpeedMultiplier) or SPOOF_CFG.DEF_INPUT) + 0.5),
        SPOOF_CFG.MIN_INPUT,
        SPOOF_CFG.MAX_INPUT
    )
    return inputSpeed * SPOOF_CFG.MULTIPLIER
end

