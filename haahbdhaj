local function updateUiCard(c, e, selected)
    if e.name ~= c.lastName then
        c.lastName = e.name
        c.name.Text = e.name .. (e.dropped and "  (dropado)" or "")
    end
    local gen = string.format("Gen: %s/s    KG: %s", fmtRate(e.value), fmtKg(e.kg))
    if gen ~= c.lastGen then
        c.lastGen = gen
        c.gen.Text = gen
    end
    local rar = "Rarity: " .. e.rarity .. "  \u{B7}  " .. e.area
    if rar ~= c.lastRar then
        c.lastRar = rar
        c.rar.Text = rar
    end
    if e.color ~= c.lastColor then
        c.lastColor = e.color
        c.rar.TextColor3 = e.color
        c.accent.BackgroundColor3 = e.color
    end
    if e.icon ~= c.lastIcon then
        c.lastIcon = e.icon
        c.image.Image = e.icon
        c.placeholder.Visible = (e.icon == "")
    end
    styleUiCard(c, selected)
end

local function updateList()
    local list = NatsuState.Eggs
    local cache = NatsuState.EggsCache
    local selUid = NatsuState.SelectedEggUid
    local visible = {}
    if listExpanded then
        for i = 1, math.min(#list, 60) do visible[i] = list[i] end
    else
        local e = (selUid and cache[selUid]) or list[1]
        if e then visible[1] = e end
    end
    local keep = {}
    for i, e in ipairs(visible) do
        local c = uiCards[e.uid]
        if not c then
            c = makeUiCard(e.uid)
            uiCards[e.uid] = c
        end
        c.frame.LayoutOrder = i
        updateUiCard(c, e, e.uid == selUid)
        keep[e.uid] = true
    end
    for uid, c in pairs(uiCards) do
        if not keep[uid] then
            uiCards[uid] = nil
            pcall(function() c.frame:Destroy() end)
        end
    end
    emptyLbl.Visible = #visible == 0
end

