        or state == Enum.HumanoidStateType.RunningNoPhysics
        or state == Enum.HumanoidStateType.Landed
end

local function NatsuAntiGuardStop()
    NatsuAntiGuardDisconnect()

    local character = LP.Character
    local original = NatsuAntiGuard.Original
    local clone = NatsuAntiGuard.Clone

    NatsuAntiGuard.Original = nil
    NatsuAntiGuard.Clone = nil
