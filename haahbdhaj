local function fmtRate(n)
    n = tonumber(n)
    if not n then return "--" end
    for _, u in ipairs({ { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
        if n >= u[1] then
            local v = n / u[1]
            local txt = (v < 10) and string.format("%.2f", v) or string.format("%.1f", v)
            if txt:find("%.") then txt = txt:gsub("0+$", ""):gsub("%.$", "") end
            return txt .. u[2]
        end
    end
    return tostring(math.floor(n))
end

local function fmtKg(n)
    n = tonumber(n) or 0
    if n <= 0 then return "?" end
    return n >= 100 and string.format("%.0f", n) or string.format("%.1f", n)
end

local function hex(c)
    return string.format("%02X%02X%02X",
        math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function tint(col, text)
    return '<font color="#' .. col .. '">' .. text .. '</font>'
end

local function normIcon(icon)
    if type(icon) == "number" then return "rbxassetid://" .. tostring(icon) end
    if type(icon) == "string" and icon ~= "" then
        if icon:match("^%d+$") then return "rbxassetid://" .. icon end
        return icon
    end
    return ""
end

