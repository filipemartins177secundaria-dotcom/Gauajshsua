--  stealEggV8 — REGRAB FIXED v3 (SEM TELA)
-- ============================================================
local function stealEggV8(record)
    if state.stealing then return false, "O roubo já está em andamento" end
    if not record or not record.Uid or not record.BoundsCFrame then return false, "Dados do ovo incompletos" end
    state.stealing = true
    state.stopRequested = false
    state.session = state.session + 1
    local mySession = state.session
    local ctx = { ok = false, msg = "" }
    local P1 = Vector3.new(CFG.P1_X, CFG.P1_Y, CFG.P1_Z)

    local function aborted()
        return mySession ~= state.session or state.stopRequested
    end

    local function cleanup()
        NatsuAntiGuardStop()
        state.stealing = false
        state.stopRequested = false
        setNoclip(false)
    end

    local ok, err = pcall(function()
        local uid = record.Uid
        local eggPos = record.BoundsCFrame.Position
        local eggModel = record.PhysicalModel

        local byOk = enableBypass()
        if not byOk then
            task.wait(0.3)
            byOk = enableBypass()
        end
        if aborted() then ctx.msg = "Interrompido"; return end

        local humInit = findHum()
        if humInit then
            pcall(function()
                humInit.WalkSpeed = CFG.WALK_SPEED_EGG
                humInit.AutoRotate = true
            end)
        end
        if CFG.NOCLIP_WALK then setNoclip(true) end

        -- ETAPA 1: VOO ATÉ O OVO
        local flyTimeout = os.clock() + CFG.WALK_TIMEOUT
        local arrived = false
        local flyConn = nil
        local flyRoot = nil
        local flyHum = nil

        local function stopNatsuFlight()
            if flyConn then
                pcall(function() flyConn:Disconnect() end)
                flyConn = nil
            end
            if flyRoot and flyRoot.Parent then
                pcall(function()
                    flyRoot.AssemblyLinearVelocity = Vector3.zero
                    flyRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            if flyHum and flyHum.Parent then
                pcall(function()
                    flyHum.PlatformStand = false
                    flyHum.AutoRotate = true
                end)
            end
        end

        local c0 = LP.Character
        flyHum = c0 and c0:FindFirstChildOfClass"Humanoid"
        flyRoot = c0 and c0:FindFirstChild"HumanoidRootPart"
        if not flyHum or not flyRoot or flyHum.Health <= 0 then
            ctx.msg = "Não foi possível iniciar o voo"
            return
        end

        local takeoffY = flyRoot.Position.Y + 50

        pcall(function()
            flyHum.WalkSpeed = CFG.WALK_SPEED_EGG
            flyHum.AutoRotate = false
            flyHum.PlatformStand = true
            flyHum:ChangeState(Enum.HumanoidStateType.Freefall)
        end)

        do
            local live0 = getLiveEggPos(eggModel, eggPos)
            local pos0 = flyRoot.Position
            local target0 = Vector3.new(live0.X, math.max(live0.Y + 50, takeoffY), live0.Z)
            local offset0 = target0 - pos0
            if offset0.Magnitude > 0.01 then
                pcall(function()
                    flyRoot.AssemblyLinearVelocity = offset0.Unit * CFG.WALK_SPEED_EGG
                    flyRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end

        flyConn = RunService.PreSimulation:Connect(function()
            if not flyRoot or not flyRoot.Parent or not flyHum or flyHum.Health <= 0 then return end
            local live = getLiveEggPos(eggModel, eggPos)
            local pos = flyRoot.Position
            local horizontal = Vector3.new(live.X - pos.X, 0, live.Z - pos.Z)
            local horizontalDistance = horizontal.Magnitude

            if horizontalDistance <= CFG.ARRIVE_DIST then
                local finalOffset = live - pos
                if finalOffset.Magnitude <= CFG.ARRIVE_DIST then
                    arrived = true
                    flyRoot.AssemblyLinearVelocity = Vector3.zero
                    flyRoot.AssemblyAngularVelocity = Vector3.zero
                    return
                end
            end

            local targetY = math.max(live.Y + 50, takeoffY)
            if horizontalDistance <= 15 then
                targetY = live.Y + 3
            end

            local target = Vector3.new(live.X, targetY, live.Z)
            local offset = target - pos
            local desired = offset.Magnitude > 0.01 and offset.Unit * CFG.WALK_SPEED_EGG or Vector3.zero

            if offset.Magnitude <= math.max(2, CFG.ARRIVE_DIST) and horizontalDistance <= 15 then
                arrived = true
                desired = Vector3.zero
            end

            pcall(function()
                flyRoot.AssemblyLinearVelocity = desired
                flyRoot.AssemblyAngularVelocity = Vector3.zero
            end)
        end)

        while os.clock() < flyTimeout do
            if aborted() then
                stopNatsuFlight()
                ctx.msg = "Interrompido"
                return
            end
            if arrived then break end
            local c = LP.Character
            local h = c and c:FindFirstChildOfClass"Humanoid"
            local r = c and c:FindFirstChild"HumanoidRootPart"
            if not h or not r or h.Health <= 0 then break end
            RunService.Heartbeat:Wait()
        end

        stopNatsuFlight()
        if not arrived then
            ctx.msg = "Não foi possível chegar ao ovo"
            return
        end
        if aborted() then ctx.msg = "Interrompido"; return end

        -- ETAPA 2: PEGA O OVO
        setNoclip(true)
        if not NatsuAntiGuardStart() then
            ctx.msg = "Anti-Guard Humanoid Swap não ativou"
            return
        end
        local pickEnd = os.clock() + CFG.PICKUP_TIMEOUT
        while os.clock() < pickEnd do
            if aborted() then break end
            if hasEggInInventory(uid) then break end
            local c = LP.Character
            local r = c and c:FindFirstChild"HumanoidRootPart"
            if not r then break end
            local live = getLiveEggPos(eggModel, eggPos)
            pcall(function()
                r.CFrame = CFrame.new(live.X, live.Y + 3, live.Z)
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end)
            triggerEggPromptsNearTarget(eggModel, live)
            invokeCarry(uid)
            RunService.Heartbeat:Wait()
        end
        if not hasEggInInventory(uid) then
            NatsuAntiGuardStop()
            ctx.msg = "Não foi possível pegar o ovo"
            return
        end

        NatsuAntiGuardStop()
        if aborted() then ctx.msg = "Interrompido"; return end

        -- ETAPA 3: TRAVA EM P1
        setNoclip(true)
        local lockConn = RunService.Heartbeat:Connect(function()
            local r = findHRP()
            if not r then return end
            r.CFrame = CFrame.new(P1)
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
        track(lockConn)
        local lockEnd = os.clock() + CFG.LOCK_TIME
        while os.clock() < lockEnd do
            if aborted() then break end
            RunService.Heartbeat:Wait()
        end
        if lockConn then pcall(function() lockConn:Disconnect() end) end
        if aborted() then ctx.msg = "Interrompido"; return end

        -- ETAPA 4: DROP + MORTE IMEDIATA
        local charBeforeDeath = LP.Character
        local humBeforeDeath = charBeforeDeath and charBeforeDeath:FindFirstChildOfClass"Humanoid"
        local deathDetected = false
        local deathConn = nil

        if humBeforeDeath then
            deathConn = humBeforeDeath.Died:Connect(function()
                deathDetected = true
            end)
            track(deathConn)
        end

        invokeDrop()

        if humBeforeDeath and humBeforeDeath.Parent and humBeforeDeath.Health > 0 then
            pcall(function() humBeforeDeath.Health = 0 end)
        end

        if aborted() then
            if deathConn then pcall(function() deathConn:Disconnect() end) end
            ctx.msg = "Interrompido"
            return
        end

        local deathEnd = os.clock() + 12
        while os.clock() < deathEnd and not deathDetected do
            if aborted() then
                if deathConn then pcall(function() deathConn:Disconnect() end) end
                ctx.msg = "Interrompido"
                return
            end
            local currentChar = LP.Character
            local currentHum = currentChar and currentChar:FindFirstChildOfClass"Humanoid"
            if humBeforeDeath and humBeforeDeath.Health <= 0 then
                deathDetected = true
                break
            end
            if currentHum and currentHum.Health <= 0 then
                deathDetected = true
                break
            end
            if charBeforeDeath ~= currentChar then
                deathDetected = true
                break
            end
            RunService.Heartbeat:Wait()
        end

        if deathConn then
            pcall(function() deathConn:Disconnect() end)
            deathConn = nil
        end

        if not deathDetected then
            ctx.msg = "A morte do personagem não foi detectada"
            return
        end

        -- ETAPA 6: MORTE -> RENASCIMENTO -> PRIMEIRO TP
        setNoclip(true)
        local respawnEnd = os.clock() + 15
        local newRoot = nil
        local newHum = nil

        while os.clock() < respawnEnd do
            if aborted() then ctx.msg = "Interrompido"; return end
            local c = LP.Character
            local h = c and c:FindFirstChildOfClass"Humanoid"
            local r = c and c:FindFirstChild"HumanoidRootPart"
            if c and h and r and h.Health > 0 then
                if c ~= charBeforeDeath or h ~= humBeforeDeath then
                    newHum = h
                    newRoot = r
                    break
                end
            end
            RunService.Heartbeat:Wait()
        end

        if not newRoot then
            ctx.msg = "Não foi possível encontrar o personagem após o renascimento"
            return
        end

        pcall(function()
            newRoot.CFrame = CFrame.new(P1.X, P1.Y + 3, P1.Z)
            newRoot.AssemblyLinearVelocity = Vector3.zero
            newRoot.AssemblyAngularVelocity = Vector3.zero
        end)

        pcall(function()
            local cam = Workspace.CurrentCamera
            if cam and newHum then
                cam.CameraSubject = newHum
                cam.CameraType = Enum.CameraType.Custom
            end
        end)

        -- ETAPA 6b: REGRAB IMEDIATO
        if not NatsuAntiGuardStart(true) then
            ctx.msg = "Anti-Guard Humanoid Swap não ativou no regrab"
            return
        end
        local reEnd = os.clock() + 8
        local rePicked = false
        local firstRegrab = true
        while os.clock() < reEnd do
            if aborted() then break end
            if hasEggInInventory(uid) then
                rePicked = true
                break
            end
            local c = LP.Character
            local r = c and c:FindFirstChild"HumanoidRootPart"
            if not r then break end
            local live = P1
            local droppedModel = nil
            if not firstRegrab then
                local eggs = readFieldEggs()
                for _, e in ipairs(eggs) do
                    if tostring(e.Uid) == tostring(uid) and e.BoundsCFrame then
                        live = e.BoundsCFrame.Position
                        droppedModel = e.PhysicalModel
                        break
                    end
                end
            end
            if (r.Position - live).Magnitude > 3 then
                pcall(function()
                    r.CFrame = CFrame.new(live.X, live.Y + 3, live.Z)
                    r.AssemblyLinearVelocity = Vector3.zero
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            triggerEggPromptsNearTarget(droppedModel, live)
            invokeCarry(uid)
            if firstRegrab then
                firstRegrab = false
            end
            RunService.Heartbeat:Wait()
        end
        if not rePicked then
            NatsuAntiGuardStop()
            ctx.msg = "Não foi possível pegar o ovo novamente"
            return
        end

        NatsuAntiGuardStop()
        if aborted() then ctx.msg = "Interrompido"; return end

        -- ETAPA 8: CORRE PRO SPAWN
        setNoclip(false)
        local spawnPart = Workspace:FindFirstChild"SpawnLocation"
        local spawnPos = spawnPart and spawnPart.Position or P1
        local hum7 = findHum()
        if hum7 then
            pcall(function()
                hum7.WalkSpeed = CFG.WALK_SPEED_SPAWN
                hum7.AutoRotate = true
            end)
        end
        local runTimeout = os.clock() + 45
        while os.clock() < runTimeout do
            if aborted() then break end
            local c = LP.Character
            local h = c and c:FindFirstChildOfClass"Humanoid"
            local r = c and c:FindFirstChild"HumanoidRootPart"
            if not h or not r then break end
            pcall(function()
                if h.WalkSpeed ~= CFG.WALK_SPEED_SPAWN then
                    h.WalkSpeed = CFG.WALK_SPEED_SPAWN
                end
            end)
            if (r.Position - spawnPos).Magnitude <= 6 then break end
            pcall(function() h:MoveTo(spawnPos) end)
            RunService.Heartbeat:Wait()
        end
        ctx.ok = true
        ctx.msg = "OK"
    end)

    cleanup()
