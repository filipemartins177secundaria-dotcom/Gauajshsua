--  REFRESH
-- ============================================================
local refreshBusy = false

local function refresh()
    if refreshBusy or not uiAlive then return false end
    refreshBusy = true
    local ok, err = pcall(function()
        local list, cache = readEggs()
        NatsuState.Eggs = list
        NatsuState.EggsCache = cache
        NatsuState.EggOrder = {}
        for i, e in ipairs(list) do NatsuState.EggOrder[i] = e.uid end
        local sel = NatsuState.SelectedEggUid
        if sel and not cache[sel] and not NatsuState.Running then
            NatsuState.SelectedEggUid = nil
            sel = nil
        end
        if not sel and not NatsuState.Running and list[1] then
            NatsuState.SelectedEggUid = list[1].uid
            setStatus("Melhor: " .. list[1].name, T.sub)
        elseif not sel and not list[1] and not NatsuState.Running then
            setStatus("Nenhum ovo no campo", T.dim)
        end
        if panelOpen then pcall(updateList) end
        pcall(espUpdate, list)
    end)
    refreshBusy = false
    if not ok then warn("[emorfz] refresh error: " .. tostring(err)) end
    return ok
end

local function forceRefresh()
    if not uiAlive then return false end
    pcall(function() NatsuEggCmds.RequestAreaEggSnapshot() end)
    task.wait(0.15)
    return refresh() ~= false
end

selectEgg = function(uid)
    local e = NatsuState.EggsCache[uid]
    if not e then return end
    NatsuState.SelectedEggUid = uid
    playClick()
    if not NatsuState.Running then
        setStatus("Selecionado: " .. e.name, T.sub)
    end
    pcall(updateList)
    pcall(espUpdate, NatsuState.Eggs)
end

