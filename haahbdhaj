local function clampToScreen(target)
    local cam = Workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
    local size = target.AbsoluteSize
    local x = math.clamp(target.Position.X.Offset, 0, math.max(0, vp.X - math.min(size.X, 60)))
    local y = math.clamp(target.Position.Y.Offset, 0, math.max(0, vp.Y - math.min(size.Y, 40)))
    target.Position = UDim2.fromOffset(x, y)
end

local function makeDraggable(handle, target, onTap)
    local dragging, moved = false, false
    local dragStart, startPos, startInput

    local function finish()
        if not dragging then return end
        dragging = false
        if not moved and onTap then onTap() end
    end

    uiTrack(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart = input.Position
            startPos = target.Position
            startInput = input
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    conn:Disconnect()
                    finish()
                end
            end)
        end
    end))

    uiTrack(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
        local isTouch = input.UserInputType == Enum.UserInputType.Touch and input == startInput
        if not (isMouse or isTouch) then return end
        local delta = input.Position - dragStart
        if delta.Magnitude > 6 then moved = true end
        if moved then
            target.Position = UDim2.fromOffset(
                startPos.X.Offset + delta.X,
                startPos.Y.Offset + delta.Y
            )
            clampToScreen(target)
        end
    end))

    uiTrack(UserInputService.InputEnded:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1
            or (t == Enum.UserInputType.Touch and input == startInput) then
            finish()
        end
    end))
end

