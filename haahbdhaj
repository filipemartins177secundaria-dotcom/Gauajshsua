local function RyuzakiGetNatsuRecord(uid)
    if not uid then return nil end
    local entry = NatsuState.EggsCache and NatsuState.EggsCache[uid]
    if entry and type(entry.record) == "table" then return entry.record end
    local ok, rec = pcall(function()
        return require(ReplicatedStorage.Client.EggState).ReadFieldEgg(uid)
    end)
    if ok and type(rec) == "table" then return rec end
    return nil
end

local function RyuzakiStopSteal()
    state.stopRequested = true
    state.session = state.session + 1
    state.stealing = false
    pcall(NatsuAntiGuardStop)
    pcall(setNoclip, false)
    Config.AutoSteal = false
    stopAllActiveMovements()
    stopGlobalMovementProtection()
    NatsuState.Running = false
end

