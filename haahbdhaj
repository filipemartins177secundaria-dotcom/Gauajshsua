local function normKey(s)
    return tostring(s or""):lower():gsub("[%s_%-%[%]%(%)%.'/\\]","")
end

local function getAssetDir()
    if type(AssetsData) ~= "table" then return nil end
    return AssetsData.Directory or AssetsData.Assets or AssetsData
end

local function getAssetInfo(cat)
    local dir = getAssetDir()
    if not dir or not cat or cat == "" then return nil end
    if dir[cat] then return dir[cat] end
    local k = normKey(cat)
    for kk, v in pairs(dir) do
        if normKey(kk) == k then return v end
        if type(v) == "table" and (normKey(v.DisplayName) == k or normKey(v.Name) == k) then
            return v
        end
    end
    return nil
end

local function toImageId(v)
    if v == nil then return "" end
    if type(v) == "number" then return "rbxassetid://"..tostring(v) end
    local t = tostring(v)
    if t == "" then return "" end
    if t:match"^%d+$" then return "rbxassetid://"..t end
    return t
end

local function getEggIcon(rec)
    local cat = tostring(rec.AssetCategory or rec.Category or rec.Name or "Egg")
    local icon = rec.Icon or rec.Image or rec.Thumbnail or rec.Texture or rec.Decal
    local info = getAssetInfo(cat)
    if type(info) == "table" then
        icon = icon or info.Icon or info.Image or info.Thumbnail or info.Texture or info.Decal
        if type(info.Pet) == "table" then
            icon = icon or info.Pet.Icon or info.Pet.Image or info.Pet.Texture
        end
        if type(info.Egg) == "table" then
            icon = icon or info.Egg.Icon or info.Egg.Image or info.Egg.Texture
        end
    end
    return toImageId(icon)
end

local function getRarityName(egg)
    local r = egg.Rarity
    if r then
        return type(r) == "table" and (r.DisplayName or r._id or r.Name) or tostring(r)
    end
    local dir = getAssetDir()
    local cat = egg.AssetCategory or egg.Category or egg.Name
    if dir and cat and dir[cat] and dir[cat].Rarity then
        local rr = dir[cat].Rarity
        return type(rr) == "table" and (rr.DisplayName or rr._id) or tostring(rr)
    end
    return "Common"
end

local function mutationMult(rec)
    local m = 1
    local muts = rec.Mutations or rec.Mutation
    if type(muts) == "table" then
        for _, mm in pairs(muts) do
            if type(mm) == "table" then
                m = m * (tonumber(mm.Multiplier or mm.Value or mm.Scale) or 1.5)
            else
                local t = tostring(mm):lower()
                if t:find"rainbow" then m = m * 3
                elseif t:find"gold" then m = m * 2
                elseif t:find"silver" then m = m * 1.5
                elseif t:find"parasite" or t:find"monstrous" then m = m * 5
                else m = m * 1.25 end
            end
        end
    elseif muts then
        m = m * 1.5
    end
    if rec.HasParasite then m = m * 5 end
    return m
end

local function eggMoney(rec)
    local cat = tostring(rec.AssetCategory or rec.Category or rec.Name or "Egg")
    local info = getAssetInfo(cat)
    local raw = tonumber(rec.Money or rec.Cash or rec.Income or rec.EarningRate or rec.Value or rec.Price)
    if (not raw or raw <= 0) and type(info) == "table" then
        raw = tonumber(info.Money or info.Cash or info.Income or info.EarningRate or info.ProfileIncome or info.SalePrice or info.Price)
        if (not raw or raw <= 0) and type(info.Egg) == "table" then
            raw = tonumber(info.Egg.Money or info.Egg.Income or info.Egg.EarningRate or info.Egg.SalePrice)
        end
    end
    raw = tonumber(raw) or 0
    local scale = tonumber(rec.AssetScale or rec.Scale or rec.NestScale) or 1
    local v = raw * scale * mutationMult(rec)
    if v <= 0 then
        local rn = getRarityName(rec)
        local score = RARITY_SCORE[rn] or 100
        local zone = tonumber(tostring(rec.AreaId or ""):match"%d+") or 50
        v = score * math.max(zone, 50) * math.max(scale, 1)
    end
    return v
end

local function formatMoney(n)
    n = tonumber(n) or 0
    if n >= 1000000000000 then return string.format("%.2fT", n/1000000000000) end
    if n >= 1000000000 then return string.format("%.2fB", n/1000000000) end
    if n >= 1000000 then return string.format("%.2fM", n/1000000) end
    if n >= 1000 then return string.format("%.2fK", n/1000) end
    return tostring(math.floor(n + 0.5))
end

local function looksLikeEggModel(m)
    if not m or not m:IsA"Model" then return false end
    local n = tostring(m.Name or "")
    if n:find"FirstArea" then return false end
    return m:GetAttribute"UID" or m:GetAttribute"Uid" or m:GetAttribute"Category" or m:GetAttribute"AssetCategory" or n:lower():find("egg", 1, true)
end

local function readFieldEggs()
    loadMods()
    local out, seen = {}, {}
    local function add(rec)
        if not rec or not rec.Uid then return end
        local k = tostring(rec.Uid)
        if seen[k] then return end
        seen[k] = true
        table.insert(out, rec)
    end
    local slots = Workspace:FindFirstChild"AreaEggSlotsClient"
    if slots then
        for _, m in ipairs(slots:GetChildren()) do
            if looksLikeEggModel(m) then
                local ok, pivot = pcall(function() return m:GetPivot() end)
                if ok and pivot then
                    add{
                        Uid = m:GetAttribute"UID" or m:GetAttribute"Uid" or m.Name,
                        AssetCategory = m:GetAttribute"Category" or m:GetAttribute"AssetCategory" or m.Name,
                        AreaId = m:GetAttribute"AreaId" or m:GetAttribute"Area",
                        Rarity = m:GetAttribute"Rarity",
                        AssetScale = tonumber(m:GetAttribute"Scale" or m:GetAttribute"AssetScale") or 1,
                        Mutations = m:GetAttribute"Mutations" or m:GetAttribute"Mutation",
                        BoundsCFrame = pivot,
                        CFrame = pivot,
                        State = "Slot",
                        PhysicalModel = m
                    }
                end
            end
        end
    end
    if EggState and EggState.ReadFieldEggs then
        local result, done = nil, false
        task.spawn(function()
            local ok, snap = pcall(EggState.ReadFieldEggs)
            if ok and snap then result = snap end
            done = true
        end)
        local waitUntil = os.clock() + 1.5
        while not done and os.clock() < waitUntil do
            RunService.Heartbeat:Wait()
        end
        if result then
            local recs = result.Records or result
            if type(recs) == "table" then
                for _, r in pairs(recs) do
                    if type(r) == "table" and r.Uid and r.BoundsCFrame and (r.State == "Slot" or r.State == "Dropped" or r.State == nil) then
                        add(r)
                    end
                end
            end
        end
    end
    return out
end

local function isEggTool(tool)
    if not tool or not tool:IsA"Tool" then return false end
    local kind = tostring(tool:GetAttribute"ItemType" or ""):lower()
    if kind == "asset" or kind == "gear" or kind == "mutationconsumable" then return false end
    if kind == "egg" or kind == "fieldegg" or kind == "eggtool" then return true end
    if tool:GetAttribute"IsEgg" == true or tool:GetAttribute"EggUid" ~= nil then return true end
    return tool.Name:lower():find("egg", 1, true) ~= nil and (tool:GetAttribute"UID" ~= nil or tool:GetAttribute"Uid" ~= nil)
end

local function hasEggInInventory(uid)
    local ch = LP.Character
    if ch then
        for _, item in ipairs(ch:GetChildren()) do
            if isEggTool(item) then
                local id = item:GetAttribute"UID" or item:GetAttribute"Uid" or item:GetAttribute"EggUid"
                if not uid or id == uid or not id then return true end
            end
        end
    end
    local bp = LP:FindFirstChild"Backpack"
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if isEggTool(item) then
                local id = item:GetAttribute"UID" or item:GetAttribute"Uid" or item:GetAttribute"EggUid"
                if not uid or id == uid or item.Name == tostring(uid) then return true end
            end
        end
    end
    if uid and EggState and EggState.ReadFieldEggs then
        local ok, snap = pcall(EggState.ReadFieldEggs)
        if ok and snap then
            local recs = snap.Records or snap
            if type(recs) == "table" then
                for _, r in pairs(recs) do
                    if type(r) == "table" and tostring(r.Uid) == tostring(uid) then
                        if (r.State == "Carried" or r.State == 2) and tostring(r.CarrierUserId or r.Carrier) == tostring(LP.UserId) then
                            return true
                        end
                    end
                end
            end
        end
    end
    return false
end

local function triggerEggPromptsNearTarget(model, targetPos)
    if model then
        for _, r in ipairs(model:GetDescendants()) do
            if r:IsA"ProximityPrompt" then
                pcall(function()
                    r.RequiresLineOfSight = false
                    r.HoldDuration = 0
                    if typeof(fireproximityprompt) == "function" then
                        fireproximityprompt(r, 0)
                        fireproximityprompt(r)
                    end
                end)
            end
        end
    end
    local slots = Workspace:FindFirstChild"AreaEggSlotsClient"
    if slots and targetPos then
        for _, slotModel in ipairs(slots:GetChildren()) do
            local part = slotModel:FindFirstChildWhichIsA"BasePart" or slotModel.PrimaryPart
            if part and (part.Position - targetPos).Magnitude <= 18 then
                for _, r in ipairs(slotModel:GetDescendants()) do
                    if r:IsA"ProximityPrompt" then
                        pcall(function()
                            r.RequiresLineOfSight = false
                            r.HoldDuration = 0
                            if typeof(fireproximityprompt) == "function" then
                                fireproximityprompt(r, 0)
                                fireproximityprompt(r)
                            end
                        end)
                    end
                end
            end
        end
    end
end

local function getLiveEggPos(eggModel, fallback)
    if eggModel then
        local eggPart = eggModel.PrimaryPart or eggModel:FindFirstChildWhichIsA"BasePart"
        if eggPart then return eggPart.Position end
    end
    return fallback
end

