local function espSubText(e)
    local bits = {
        tint("57F287", "<b>" .. fmtRate(e.value) .. "/s</b>"),
        tint(hex(e.color), e.rarity),
    }
    if (e.kg or 0) > 0 then
        bits[#bits + 1] = tint("F0F0F6", fmtKg(e.kg) .. "kg")
    end
    local sub = table.concat(bits, "  \u{B7}  ")
    local lines = 1
    if #e.mutations > 0 then
        sub = sub .. "\n" .. tint("F0BE5A", table.concat(e.mutations, " \u{B7} "))
        lines = 2
    end
    return sub, lines
end

local function espApply(c, e, isSel)
    if c.pos ~= e.pos then
        c.pos = e.pos
        c.anchor.CFrame = CFrame.new(e.pos + e.lift)
    end
    local sub, lines = espSubText(e)
    local h = lines > 1 and (ESP.H + 12) or ESP.H
    if c.baseH ~= h then
        c.baseH = h
        c.frame.Size = UDim2.fromOffset(ESP.W, h)
        c.sub.Size = UDim2.new(1, -50, 0, h - 20)
        c.lastH = -1
    end
    local titleText = (isSel and "\u{25B8} " or "") .. e.name
    if titleText ~= c.lastTitle then
        c.lastTitle = titleText
        c.title.Text = titleText
    end
    if sub ~= c.lastSub then
        c.lastSub = sub
        c.sub.Text = sub
    end
    if e.icon ~= c.lastIcon then
        c.lastIcon = e.icon
        c.icon.Image = e.icon
        c.placeholder.Visible = (e.icon == "")
    end
    if e.color ~= c.lastColor then
        c.lastColor = e.color
        c.accent.BackgroundColor3 = e.color
    end
    if isSel ~= c.lastSel then
        c.lastSel = isSel
        c.stroke.Color = isSel and T.cardStrokeSel or e.color
        c.stroke.Thickness = isSel and 2 or 1.2
    end
end

local function espDestroyCard(uid)
    local c = ESP.Cards[uid]
    if c then
        ESP.Cards[uid] = nil
        pcall(function() c.anchor:Destroy() end)
    end
end

local function espClear()
    for uid in pairs(ESP.Cards) do espDestroyCard(uid) end
end

local function espUpdate(list)
    if not ESP.Enabled then espClear(); return end
    local cam = Workspace.CurrentCamera
    if not cam then return end
    local eye = cam.CFrame.Position
    local selUid = NatsuState.SelectedEggUid
    local wanted, n, built = {}, 0, 0
    for _, e in ipairs(list) do
        if n >= ESP.MAX_CARDS then break end
        if (e.pos - eye).Magnitude <= ESP.MAX_DIST then
            n = n + 1
            wanted[e.uid] = true
            local c = ESP.Cards[e.uid]
            if not c and built < ESP.BUILD_PER_TICK then
                built = built + 1
                c = espBuild()
                ESP.Cards[e.uid] = c
            end
            if c then espApply(c, e, e.uid == selUid) end
        end
    end
    for uid in pairs(ESP.Cards) do
        if not wanted[uid] then espDestroyCard(uid) end
    end
end

do
    local acc = 0
    uiTrack(RunService.Heartbeat:Connect(function(dt)
        acc = acc + (dt or 0)
        if acc < 1 / 12 then return end
        acc = 0
        local cam = Workspace.CurrentCamera
        if not cam or not ESP.Enabled then return end
        local eye = cam.CFrame.Position
        for _, c in pairs(ESP.Cards) do
            if c.anchor.Parent then
                local d = (c.anchor.Position - eye).Magnitude
                local show = d <= ESP.MAX_DIST
                if c.bb.Enabled ~= show then c.bb.Enabled = show end
                if show then
                    local s = espScaleFor(d)
                    if math.abs(c.lastScale - s) > 0.01 or c.lastH ~= c.baseH then
                        c.lastScale, c.lastH = s, c.baseH
                        c.uiScale.Scale = s
                        c.bb.Size = UDim2.fromOffset(ESP.W * s, c.baseH * s)
                    end
                    local fade = math.clamp((ESP.MAX_DIST - d) / ESP.FADE_BAND, 0, 1)
                    if math.abs(c.lastFade - fade) > 0.02 then
                        c.lastFade = fade
                        c.frame.BackgroundTransparency = 1 - (1 - ESP.BASE_ALPHA) * fade
                        c.title.TextTransparency = 1 - fade
                        c.sub.TextTransparency = 1 - fade
                        c.icon.ImageTransparency = 1 - fade
                        c.placeholder.TextTransparency = 1 - fade
                        c.stroke.Transparency = 1 - (1 - ESP.BASE_STROKE) * fade
                    end
                end
            end
        end
    end))
end

