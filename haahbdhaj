        if token ~= stealOverlayToken or not stealOverlayGui.Enabled then return end
        local dots = string.rep(".", (math.floor(os.clock() * 3) % 4))
        stealOverlayStatus.Text = stealOverlayStatus.Text:gsub("%.+$", "") .. dots
    end)
end

local function setStealOverlayStep(index, text)
    if not stealOverlayGui or not stealOverlayGui.Enabled then return end
    local progress = {0.22, 0.52, 0.78, 1.0}
    index = math.clamp(tonumber(index) or 1, 1, #progress)
    stealOverlayTitle.Text = "LEVON X NATSU"
    stealOverlayStatus.Text = tostring(text or "Carregando") .. "..."
    TweenService:Create(stealOverlayFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.fromScale(progress[index], 1)
    }):Play()
end

