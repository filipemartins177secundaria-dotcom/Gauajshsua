local function doSpam4Dir(P1, mySession)
    local dirs = {
        Vector3.new(0, CFG.SPAM_UP, 0),
        Vector3.new(0, -CFG.SPAM_DOWN, 0),
        Vector3.new(-CFG.SPAM_LEFT, 0, 0),
        Vector3.new(CFG.SPAM_RIGHT, 0, 0)
    }
    local stepDelay = CFG.SPAM_STEP_DELAY
    if stepDelay < 0.001 then stepDelay = nil end
    for _, offset in ipairs(dirs) do
        if mySession ~= state.session or state.stopRequested then return end
        local farPos = P1 + offset
        local r1 = findHRP()
        if r1 then
            pcall(function()
                r1.CFrame = CFrame.new(farPos)
                r1.AssemblyLinearVelocity = Vector3.zero
                r1.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        if stepDelay then task.wait(stepDelay) else RunService.Heartbeat:Wait() end
        if mySession ~= state.session or state.stopRequested then return end
        local r2 = findHRP()
        if r2 then
            pcall(function()
                r2.CFrame = CFrame.new(P1)
                r2.AssemblyLinearVelocity = Vector3.zero
                r2.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        if stepDelay then task.wait(stepDelay) else RunService.Heartbeat:Wait() end
    end
end

