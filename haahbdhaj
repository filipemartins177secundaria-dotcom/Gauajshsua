local valueCache = {}
local valueCacheN = 0

local function calcValue(rec)
    local uid = rec.Uid
    local hit = valueCache[uid]
    if hit ~= nil then return hit end
    if not AssetEarnings then return nil end
    local item = {
        Category = rec.AssetCategory,
        Scale = tonumber(rec.AssetScale) or 1,
        Mutations = rec.Mutations or {},
    }
    local v = nil
    if type(AssetEarnings.LiveRatePerSecond) == "function" then
        local ok, rate = pcall(AssetEarnings.LiveRatePerSecond, item, nil, nil, LocalPlayer)
        if ok and type(rate) == "number" then v = rate end
    end
    if v == nil and type(AssetEarnings.MutationOnlyRatePerSecond) == "function" then
        local ok, rate = pcall(AssetEarnings.MutationOnlyRatePerSecond, item)
        if ok and type(rate) == "number" then v = rate end
    end
    if v == nil then return nil end
    if valueCacheN >= 600 then
        valueCache, valueCacheN = {}, 0
    end
    valueCache[uid] = v
    valueCacheN = valueCacheN + 1
    return v
end

local function mutationNames(rec)
    local names = {}
    local m = rec.Mutations
    if type(m) ~= "table" then return names end
    for k, mu in pairs(m) do
        if type(mu) == "table" then
            names[#names + 1] = tostring(mu.DisplayName or mu._id or "?")
        elseif type(mu) == "string" then
            names[#names + 1] = mu
        elseif mu == true and type(k) == "string" then
            names[#names + 1] = k
        end
    end
    table.sort(names)
    return names
end

local function buildEntry(rec)
    local dir = rec.AssetCategory and NatsuAssets[rec.AssetCategory] or nil
    local petName = (dir and dir.DisplayName) or rec.AssetCategory or "?"
    local eggName = (dir and dir.Egg and dir.Egg.DisplayName) or (tostring(petName) .. " Egg")
    local rarityName = "?"
    local color = DEFAULT_COLOR
    if dir and dir.Rarity then
        rarityName = tostring(dir.Rarity.DisplayName or dir.Rarity._id or "?")
        if typeof(dir.Rarity.Color) == "Color3" then
            color = dir.Rarity.Color
        elseif RARITY_COLORS[rarityName] then
            color = RARITY_COLORS[rarityName]
        end
    end
    local scale = tonumber(rec.AssetScale) or 1
    local kg = 0
    if dir and dir.Egg and tonumber(dir.Egg.WeightKg) then
        kg = tonumber(dir.Egg.WeightKg) * scale
    end
    local cf = rec.BoundsCFrame
    local fromBottom = false
    if typeof(cf) ~= "CFrame" then
        cf = rec.BottomCFrame
        fromBottom = true
    end
    if typeof(cf) ~= "CFrame" then return nil end
    return {
        uid = rec.Uid,
        record = rec,
        name = tostring(petName),
        eggName = tostring(eggName),
        area = tostring(rec.AreaId or "?"),
        rarity = rarityName,
        rank = RARITY_RANK[rarityName] or 0,
        color = color,
        icon = normIcon(dir and dir.Icon),
        value = calcValue(rec),
        kg = kg,
        pos = cf.Position,
        lift = Vector3.new(0, (fromBottom and 3 or 0) + 2.2 + scale * 3.4, 0),
        mutations = mutationNames(rec),
        dropped = rec.State == "Dropped",
    }
end

local currentSort = "GEN"

local function sortEntries(list)
    table.sort(list, function(a, b)
        if currentSort == "RARITY" and a.rank ~= b.rank then
            return a.rank > b.rank
        end
        local av, bv = a.value or -1, b.value or -1
        if av ~= bv then return av > bv end
        if a.rank ~= b.rank then return a.rank > b.rank end
        if a.name ~= b.name then return a.name < b.name end
        return tostring(a.uid) < tostring(b.uid)
    end)
end

local function readEggs()
    local list, cache, seen = {}, {}, {}
    local ok, snapshot = pcall(NatsuEggCmds.ReadFieldEggs)
    if ok and type(snapshot) == "table" and type(snapshot.Records) == "table" then
        for _, rec in pairs(snapshot.Records) do
            if type(rec) == "table" and rec.Uid and not seen[rec.Uid]
                and (rec.State == "Slot" or rec.State == "Dropped") then
                seen[rec.Uid] = true
                local okE, entry = pcall(buildEntry, rec)
                if okE and entry then
                    list[#list + 1] = entry
                    cache[entry.uid] = entry
                end
            end
        end
    end
    sortEntries(list)
    return list, cache
end

