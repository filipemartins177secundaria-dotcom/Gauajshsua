    stealOverlayToken = stealOverlayToken + 1
    if stealOverlayConn then
        pcall(function() stealOverlayConn:Disconnect() end)
        stealOverlayConn = nil
    end
    if stealOverlayGui then stealOverlayGui.Enabled = false end
end

local function showStealOverlay()
    createStealOverlay()
    stealOverlayToken = stealOverlayToken + 1
    local token = stealOverlayToken
    if stealOverlayConn then pcall(function() stealOverlayConn:Disconnect() end) end
    stealOverlayGui.Enabled = true
    stealOverlayFill.Size = UDim2.fromScale(0, 1)
    stealOverlayTitle.Text = "LEVON X NATSU"
    stealOverlayStatus.Text = "CARREGANDO..."
